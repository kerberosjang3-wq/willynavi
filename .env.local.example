# ── 국가교통정보센터 (ITS) ──────────────────────────────────────────────────────
# https://openapi.its.go.kr 에서 발급
ITS_API_KEY=your_its_api_key_here

# ── 서울 열린데이터광장 ────────────────────────────────────────────────────────
# https://data.seoul.go.kr 에서 발급
SEOUL_API_KEY=your_seoul_api_key_here

# ── 카카오 지도 (선택) ──────────────────────────────────────────────────────────
# https://developers.kakao.com 에서 발급
NEXT_PUBLIC_KAKAO_MAP_KEY=your_kakao_key_here

# ── 개발 환경 Mock 데이터 사용 여부 ────────────────────────────────────────────
# "true" 로 설정하면 실 API 없이 개발 가능
NEXT_PUBLIC_USE_MOCK_DATA=true
